# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...   # or the legacy anon key in NEXT_PUBLIC_SUPABASE_ANON_KEY

# Public website, for links out of the portal
NEXT_PUBLIC_SITE_URL=https://xplorevietnam.com

# Free consultation calendar: your Cal.com or Calendly booking link
NEXT_PUBLIC_BOOKING_URL=

# Optional: welcome video (.mp4, e.g. in Supabase Storage)
NEXT_PUBLIC_WELCOME_VIDEO_URL=

# ── Payments (Stripe Checkout). Leave empty to record requests instead of taking payment. ──
# Server-only secret key: creates the checkout sessions
STRIPE_SECRET_KEY=
# Webhook signing secret: proves "payment completed" messages really come from Stripe
STRIPE_WEBHOOK_SECRET=
# Supabase admin key, server-only: lets the webhook mark a request as paid (clients can't)
SUPABASE_SERVICE_ROLE_KEY=
# Set to 1 once Stripe is live (shows "Secure payment processing via Stripe")
NEXT_PUBLIC_STRIPE_ENABLED=
